# --- Obsidian volatile UI state (churns on every interaction; do NOT track) ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/*.json.bak

# Keep the rest of .obsidian/ (plugins, themes, app/appearance/hotkeys config)
# and .claude/ (skills, settings, scripts) tracked — the vault should be
# reproducible across machines and agent runs.

# --- Obsidian trash & OS cruft ---
.trash/
.DS_Store
Thumbs.db
desktop.ini

# --- per-machine plugin state that churns (uncomment if it causes conflicts) ---
# .obsidian/plugins/obsidian-git/data.json

# --- Claude Code per-machine local settings (permission grants, etc.) ---
.claude/settings.local.json

# --- Inbox raw source dumps ---
# Source PDFs are tracked via git-LFS (see .gitattributes); the .zip/.tex bundles
# they came from are not — they're transient staging and the PDF is the artifact.
00-Inbox/*.zip

# --- PDFs (attachments/@citekey.pdf + 00-Inbox/*.pdf) are tracked via git-LFS ---
# See .gitattributes. To keep a device lean, clone with LFS smudge disabled so you
# get ~130-byte pointers instead of ~2.5 GB of PDFs:
#     git lfs install --skip-smudge          # once per device, global
#     git clone git@github.com:wdc3iii/otto.git
#     cd otto && git config lfs.fetchexclude "*"
# then fetch on demand:
#     git lfs pull --include="attachments/@ames2019cbf.pdf"
# NOTE: on a skip-smudge device the pointer files will NOT open in Obsidian until
# you pull them. Obsidian mobile's git plugin does not support LFS at all.
