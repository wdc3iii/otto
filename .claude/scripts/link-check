#!/usr/bin/env python3
"""link-check — report broken [[wikilinks]] / ![[embeds]] in the otto vault.

Usage: link-check [VAULT_ROOT]   (defaults to the repo root, two levels up)
Exit code 1 if any broken links are found, else 0.

Notes:
 - Same-note links ([[#heading]] / [[#^block]]) are ignored.
 - Fenced code blocks, inline code spans, and HTML comments are stripped before
   scanning (so example links in code/comments are not flagged).
 - Templates/ is not scanned (placeholder links) but its files ARE valid targets.
 - Resolution is case-insensitive and matches by vault-relative path OR by
   basename (Obsidian "shortest path") OR by frontmatter alias.
"""
import re, sys, yaml
from pathlib import Path

INDEX_EXCLUDE = {".git", ".obsidian", ".claude", ".trash"}
SCAN_SKIP_TOP = {"Templates"}
WIKILINK = re.compile(r"!?\[\[([^\]]+?)\]\]")


def vault_root():
    if len(sys.argv) > 1:
        return Path(sys.argv[1]).resolve()
    return Path(__file__).resolve().parents[2]


def aliases_of(path):
    try:
        text = path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return []
    if not text.startswith("---"):
        return []
    m = re.match(r"---\n(.*?)\n---", text, flags=re.S)
    if not m:
        return []
    try:
        fm = yaml.safe_load(m.group(1)) or {}
    except Exception:
        return []
    al = fm.get("aliases")
    if isinstance(al, str):
        return [al]
    if isinstance(al, list):
        return [str(x) for x in al]
    return []


def index_files(root):
    keys = set()
    for p in root.rglob("*"):
        if p.is_dir():
            continue
        if p.relative_to(root).parts[0] in INDEX_EXCLUDE:
            continue
        rel = p.relative_to(root).as_posix().lower()
        keys.add(rel)                                  # full path with extension
        if rel.endswith(".md"):
            keys.add(rel[:-3])                         # path without .md
        keys.add(p.name.lower())                       # basename with extension
        if p.suffix.lower() == ".md":
            keys.add(p.stem.lower())                   # basename without extension
            for a in aliases_of(p):
                keys.add(a.lower())
    return keys


def strip_noise(text):
    text = re.sub(r"```.*?```", "", text, flags=re.S)   # fenced code
    text = re.sub(r"`[^`\n]*`", "", text)               # inline code
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)  # html comments
    return text


def norm_target(t):
    t = t.split("|", 1)[0].split("#", 1)[0].strip()
    if t.startswith("./"):
        t = t[2:]
    return t.replace("\\", "/").lower()


def resolve(t, keys):
    if not t:                       # same-note link
        return True
    if t in keys:
        return True
    if t.endswith(".md") and t[:-3] in keys:
        return True
    return False


def main():
    root = vault_root()
    keys = index_files(root)
    broken = []
    for p in root.rglob("*.md"):
        parts = p.relative_to(root).parts
        if parts[0] in INDEX_EXCLUDE or parts[0] in SCAN_SKIP_TOP:
            continue
        try:
            raw = p.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue
        for m in WIKILINK.finditer(strip_noise(raw)):
            target = norm_target(m.group(1))
            if not resolve(target, keys):
                idx = raw.find(m.group(0))
                lineno = raw[:idx].count("\n") + 1 if idx >= 0 else 0
                broken.append((p.relative_to(root).as_posix(), lineno, m.group(1).strip()))
    if broken:
        print(f"✗ {len(broken)} broken wikilink(s):")
        for f, ln, link in broken:
            print(f"  {f}:{ln}  [[{link}]]")
        sys.exit(1)
    print("✓ no broken wikilinks")
    sys.exit(0)


if __name__ == "__main__":
    main()
